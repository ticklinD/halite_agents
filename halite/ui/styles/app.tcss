/* Halite TUI Stylesheet — Hermes-inspired dark theme, no crop layout */

/* ─── Global defaults ─────────────────────────────────────────────── */
Screen {
    background: #1a1b26;
    color: #c0caf5;
}

/* ─── Chat screen layout ─────────────────────────────────────────── */
#chat-screen {
    height: 100%;
    width: 100%;
}

/* Chat messages area — takes ALL remaining space, scrollable */
#chat-container {
    height: 1fr;
    width: 100%;
    overflow-y: auto;
    padding: 0 1;
    background: #1a1b26;
}

/* Individual chat messages */
.chat-msg {
    height: auto;
    max-height: 200;
    padding: 0 0 1 0;
    margin-bottom: 0;
}

.chat-msg-user {
    color: #7aa2f7;
}

.chat-msg-assistant {
    color: #c0caf5;
}

.chat-msg-system {
    color: #565f89;
    text-style: italic;
}

.chat-msg-error {
    color: #f7768e;
}

/* ─── Thinking indicator ─────────────────────────────────────────── */
#thinking-area {
    height: auto;
    max-height: 5;
    display: none;
    padding: 0 1;
    background: #1a1b26;
}

#thinking-area.active {
    display: block;
}

/* ─── Input bar — thin, docked to bottom ─────────────────────────── */
#input-container {
    height: auto;
    min-height: 1;
    max-height: 6;
    dock: bottom;
    background: #1a1b26;
    border-top: solid #3b4261;
    padding: 0 1;
}

#user-input {
    height: auto;
    min-height: 1;
    max-height: 4;
    width: 100%;
    background: #1a1b26;
    color: #c0caf5;
    padding: 0 0;
}

#input-prompt {
    width: auto;
    min-width: 8;
    color: #7aa2f7;
    text-style: bold;
}

/* ─── Status bar — compact, bottom-most ──────────────────────────── */
#status-bar {
    height: 1;
    dock: bottom;
    background: #16161e;
    color: #565f89;
    padding: 0 1;
    width: 100%;
}

#status-model {
    width: auto;
    max-width: 40;
    color: #bb9af7;
}

#status-backend {
    width: auto;
    max-width: 20;
    color: #565f89;
}

#status-cost {
    width: auto;
    max-width: 20;
    color: #565f89;
    text-align: right;
}

#status-hint {
    width: 1fr;
    color: #3b4261;
    text-align: right;
}

/* ─── Log panel — inline when visible ────────────────────────────── */
#log-panel {
    height: 10;
    display: none;
    background: #1a1b26;
    border-top: solid #3b4261;
    overflow-y: auto;
    padding: 0 1;
}

#log-panel.visible {
    display: block;
}

/* ─── Diff view — inline when visible ────────────────────────────── */
#diff-view {
    height: 15;
    display: none;
    background: #1a1b26;
    border-top: solid #3b4261;
    overflow-y: auto;
    padding: 0 1;
}

#diff-view.visible {
    display: block;
}

/* ─── Header ─────────────────────────────────────────────────────── */
Header {
    dock: top;
    height: 1;
    background: #16161e;
    color: #7aa2f7;
}

/* ─── Footer ─────────────────────────────────────────────────────── */
Footer {
    dock: bottom;
    height: 1;
    background: #16161e;
    color: #565f89;
}

/* ─── Scrollbar styling ──────────────────────────────────────────── */
Scrollbar {
    background: #1a1b26;
}

Scrollbar-thumb {
    background: #3b4261;
}

Scrollbar-thumb:hover {
    background: #565f89;
}

/* ─── Selection highlight ────────────────────────────────────────── */
::selection {
    background: #283457;
}
