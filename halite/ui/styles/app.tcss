/* Halite TUI Stylesheet (§4, Textual) */

/* App-wide defaults */
Screen {
    background: $surface;
    color: $text;
}

/* Header bar */
Header {
    background: $accent-darken-2;
    color: $text;
    dock: top;
    height: 1;
}

/* Chat display area — takes all space not claimed by input bar / chrome */
#chat-display-container {
    width: 100%;
    height: 1fr;
    min-height: 3;
    overflow: hidden;
}

#chat-display {
    background: $surface;
    color: $text;
    padding: 0 1;
    height: 1fr;
    overflow-y: auto;
}

/* Input bar at bottom */
#input-bar {
    background: $surface-darken-1;
    height: 3;
    dock: bottom;
    width: 100%;
    border-top: solid $accent;
    padding: 0 1;
}

#chat-input {
    background: $surface;
    color: $text;
    height: 3;
    width: 100%;
}

/* Status bar — bottom-most single line */
StatusBar {
    dock: bottom;
    height: 1;
    background: $accent-darken-2;
    color: $text;
    padding: 0 1;
}

/* Log panel — hidden by default; renders inline (not docked) when shown so it
   cannot clip the chat area */
LogPanel {
    display: none;
    height: 8;
}

LogPanel.visible {
    display: block;
}

/* Diff view — hidden by default; renders inline when shown */
DiffView {
    display: none;
    height: 8;
}

DiffView.visible {
    display: block;
}
